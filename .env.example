# Copy to .env and fill in. Never commit .env.
#
# Generate the two required secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          # session
#   python -c "from dive.security import DataVault; print(DataVault.generate_key())"  # encryption

# The domain you will serve Dive on - the same one that goes in the Caddyfile.
# No https://, no port. Dive refuses websocket connections under any other
# name, which is what stops someone pointing their own domain at your server.
DIVE_PUBLIC_HOSTNAME=dive.example.org

# Where Let's Encrypt sends certificate-expiry warnings.
DIVE_TLS_EMAIL=you@example.org

DIVE_SESSION_SECRET=
DIVE_ENCRYPTION_KEY=

# First-run admin password. Leave blank and Dive generates one, printed once
# on the sign-in page. Either way you must change it at first sign-in.
DIVE_ADMIN_PASSWORD=

# Owner console. Generate with:
#   python -c "from dive.owner import OwnerGate; g=OwnerGate(); k=g.generate_key(); print('KEY :',k); print('HASH:',g.hash_key(k))"
# Keep the KEY; put the HASH here. Leave blank to disable the console.
DIVE_OWNER_KEY_HASH=

# Model providers for the evidence advisor. All optional - with none set, Dive
# makes no external calls whatsoever.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
